# ==============================================================================
# OrderMind Precision Packaging SaaS — Environment Variables Template
# ==============================================================================

# Database: MongoDB Atlas Connection (Required)
# Free M0 sandbox available at https://www.mongodb.com/atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ordermind?retryWrites=true&w=majority

# Authentication: JWT Signing Key (Required - Min 32 chars in production)
# Generate via: openssl rand -base64 32
JWT_SECRET=ordermind-super-secure-jwt-secret-min-32-chars-long-example

# Environment Mode: development | production | test
NODE_ENV=development

# Web Application Base URL (Required for CSRF, OAuth redirects, and internal linking)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server Listening Port (Optional, defaults to 3000)
PORT=3000

# ------------------------------------------------------------------------------
# Open-Source LLM Pipeline (Gemma Core)
# ------------------------------------------------------------------------------
# Provider Mode: "gemma" (default & required in production) | "mock" (unit test runner only)
LLM_PROVIDER=gemma

# Transport 1: Local Ollama (Free, runs locally on developer machine)
# Download from https://ollama.ai -> run `ollama pull gemma2:9b` -> `ollama serve`
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=gemma2:9b
LLM_API_KEY=

# Transport 2: Hosted Endpoint (Render / Groq / OpenRouter / HuggingFace / Together / vLLM)
# Example Groq: LLM_BASE_URL=https://api.groq.com/openai/v1, LLM_MODEL=gemma2-9b-it, LLM_API_KEY=gsk_...
# Example OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1, LLM_MODEL=google/gemma-2-9b-it, LLM_API_KEY=sk-or-...
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=gemma2-9b-it
# LLM_API_KEY=

# ------------------------------------------------------------------------------
# Voice Note Transcription (Speech-to-Text)
# ------------------------------------------------------------------------------
# STT Mode: "manual" (default, free text transcription) | "elevenlabs" | "whisper"
STT_PROVIDER=manual

# ElevenLabs API Key (Optional - free tier available at https://elevenlabs.io)
# Required only if STT_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=

# ------------------------------------------------------------------------------
# Observability & Agent Tracing (Optional)
# ------------------------------------------------------------------------------
# Sentry DSN for error reporting, session replay & AI stage tracing (Free tier at https://sentry.io)
# Application degrades gracefully if left blank
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Sentry Organization & Project (Optional, for sourcemap releases during build)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ------------------------------------------------------------------------------
# Storage & Upload Limits (Optional)
# ------------------------------------------------------------------------------
# Max single file upload limit in bytes (Default: 10485760 = 10MB)
MAX_UPLOAD_SIZE_BYTES=10485760
